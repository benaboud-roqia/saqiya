# Sāqiya — modèle du fichier .env (copiez-le en « .env » et remplissez-le ; ne publiez jamais le vrai .env).

# Clé Groq pour le diagnostic des photos et le conseiller : https://console.groq.com/keys
GROQ_API_KEY=

# Connexion avec Gmail : ID client OAuth « Application Web » (Google Cloud Console), finit par .apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# adresses autorisées dans Google Cloud Console (Origines JavaScript autorisées), séparées par des virgules
GOOGLE_ORIGINS=http://localhost:8000,http://localhost
